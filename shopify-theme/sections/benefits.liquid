<section class="benefits" id="benefits">
  <div class="container">
    <div class="benefits-header">
      <div class="section-label">{{ section.settings.label }}</div>
      <h2 class="section-title">{{ section.settings.title }}</h2>
      <p class="section-subtitle">{{ section.settings.subtitle }}</p>
    </div>
    <div class="benefits-grid">
      {% for block in section.blocks %}
        <div class="benefit-card" {{ block.shopify_attributes }}>
          <div class="benefit-icon">
            {% case block.settings.icon %}
              {% when 'moon' %}
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z"/></svg>
              {% when 'brain' %}
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><path d="M12 16v-4"/><path d="M12 8h.01"/></svg>
              {% when 'chart' %}
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M18 20V10"/><path d="M12 20V4"/><path d="M6 20v-6"/></svg>
              {% when 'activity' %}
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M22 12h-4l-3 9L9 3l-3 9H2"/></svg>
              {% when 'sun' %}
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="5"/><line x1="12" y1="1" x2="12" y2="3"/><line x1="12" y1="21" x2="12" y2="23"/><line x1="4.22" y1="4.22" x2="5.64" y2="5.64"/><line x1="18.36" y1="18.36" x2="19.78" y2="19.78"/><line x1="1" y1="12" x2="3" y2="12"/><line x1="21" y1="12" x2="23" y2="12"/><line x1="4.22" y1="19.78" x2="5.64" y2="18.36"/><line x1="18.36" y1="5.64" x2="19.78" y2="4.22"/></svg>
              {% when 'users' %}
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/><path d="M23 21v-2a4 4 0 0 0-3-3.87"/><path d="M16 3.13a4 4 0 0 1 0 7.75"/></svg>
              {% else %}
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"/></svg>
            {% endcase %}
          </div>
          <h3 class="benefit-title">{{ block.settings.title }}</h3>
          <p class="benefit-desc">{{ block.settings.description }}</p>
        </div>
      {% endfor %}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Benefits",
  "settings": [
    {
      "type": "text",
      "id": "label",
      "label": "Section Label",
      "default": "Benefits"
    },
    {
      "type": "html",
      "id": "title",
      "label": "Section Title",
      "default": "What NightForge Does<br>for <span class='highlight'>Your Body</span>"
    },
    {
      "type": "textarea",
      "id": "subtitle",
      "label": "Section Subtitle",
      "default": "Every ingredient and every dose is formulated to work with your body's natural recovery processes during sleep."
    }
  ],
  "blocks": [
    {
      "type": "benefit",
      "name": "Benefit Card",
      "settings": [
        {
          "type": "select",
          "id": "icon",
          "label": "Icon",
          "options": [
            { "value": "users", "label": "Users/Recovery" },
            { "value": "brain", "label": "Brain/Clarity" },
            { "value": "chart", "label": "Chart/Growth" },
            { "value": "activity", "label": "Activity/Health" },
            { "value": "sun", "label": "Sun/Energy" },
            { "value": "moon", "label": "Moon/Sleep" }
          ],
          "default": "moon"
        },
        {
          "type": "text",
          "id": "title",
          "label": "Title",
          "default": "Benefit Title"
        },
        {
          "type": "textarea",
          "id": "description",
          "label": "Description",
          "default": "Benefit description goes here."
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Benefits",
      "blocks": [
        { "type": "benefit", "settings": { "icon": "users", "title": "Deep Sleep Recovery", "description": "Supports your body's natural ability to recover and restore during your deepest sleep cycles." } },
        { "type": "benefit", "settings": { "icon": "brain", "title": "Reduce Brain Fog", "description": "Wake up with sharper mental clarity. Magnesium plays a critical role in cognitive function and neural communication." } },
        { "type": "benefit", "settings": { "icon": "chart", "title": "Muscle Recovery", "description": "Supports muscle repair and reduces tension so you wake up ready to perform at your best." } },
        { "type": "benefit", "settings": { "icon": "activity", "title": "Nervous System Support", "description": "Magnesium is essential for nervous system regulation. NightForge provides the forms your body actually absorbs." } },
        { "type": "benefit", "settings": { "icon": "sun", "title": "Restore Mg Levels", "description": "Most people are magnesium deficient. NightForge uses bioavailable forms to effectively restore your levels." } },
        { "type": "benefit", "settings": { "icon": "moon", "title": "Night Optimized", "description": "Specifically designed to be taken before bed. Works with your circadian rhythm, not against it." } }
      ]
    }
  ]
}
{% endschema %}