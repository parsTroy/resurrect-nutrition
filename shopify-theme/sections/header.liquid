<nav class="nav">
  <div class="nav-inner">
    <a href="/" class="nav-brand">
      <div class="nav-brand-icon">
        <svg viewBox="0 0 24 24" fill="none" stroke="white" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
          <path d="M13 2L3 14h9l-1 8 10-12h-9l1-8z"/>
        </svg>
      </div>
      <div class="nav-brand-text">{{ section.settings.brand_name | default: 'Resurrect' }} <span>{{ section.settings.brand_suffix | default: 'Nutrition' }}</span></div>
    </a>
    <ul class="nav-links">
      {% for link in linklists[section.settings.menu].links %}
        <li><a href="{{ link.url }}">{{ link.title }}</a></li>
      {% endfor %}
      <li><a href="{{ section.settings.cta_link | default: '/collections/all' }}" class="nav-cta">{{ section.settings.cta_text | default: 'Shop Now' }}</a></li>
    </ul>
    <button class="nav-mobile-toggle" aria-label="Menu">
      <span></span>
      <span></span>
      <span></span>
    </button>
  </div>
</nav>

{% schema %}
{
  "name": "Header",
  "settings": [
    {
      "type": "text",
      "id": "brand_name",
      "label": "Brand Name",
      "default": "Resurrect"
    },
    {
      "type": "text",
      "id": "brand_suffix",
      "label": "Brand Suffix",
      "default": "Nutrition"
    },
    {
      "type": "link_list",
      "id": "menu",
      "label": "Navigation Menu",
      "default": "main-menu"
    },
    {
      "type": "text",
      "id": "cta_text",
      "label": "CTA Button Text",
      "default": "Shop Now"
    },
    {
      "type": "url",
      "id": "cta_link",
      "label": "CTA Button Link"
    }
  ]
}
{% endschema %}