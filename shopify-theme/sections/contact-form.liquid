<section class="contact-section">
  <div class="container">
    <div class="contact-inner">
      <div class="contact-info">
        <div class="section-label">{{ section.settings.label }}</div>
        <h1 class="section-title contact-title">{{ section.settings.title }}</h1>
        <p class="section-subtitle">{{ section.settings.subtitle }}</p>

        <div class="contact-details">
          {% for block in section.blocks %}
            <div class="contact-detail-item" {{ block.shopify_attributes }}>
              {% case block.settings.icon %}
                {% when 'email' %}
                  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"/><polyline points="22,6 12,13 2,6"/></svg>
                {% when 'clock' %}
                  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><polyline points="12 6 12 12 16 14"/></svg>
                {% when 'map' %}
                  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"/><circle cx="12" cy="10" r="3"/></svg>
                {% else %}
                  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><line x1="12" y1="16" x2="12" y2="12"/><line x1="12" y1="8" x2="12.01" y2="8"/></svg>
              {% endcase %}
              <div>
                <h4>{{ block.settings.title }}</h4>
                <p>{{ block.settings.text }}</p>
              </div>
            </div>
          {% endfor %}
        </div>
      </div>

      <div class="contact-form-wrapper">
        {% form 'contact', class: 'contact-form' %}
          {% if form.posted_successfully? %}
            <div class="contact-success">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"/></svg>
              <p>{{ section.settings.success_message }}</p>
            </div>
          {% endif %}

          {% if form.errors %}
            <div class="contact-error">
              {{ form.errors | default_errors }}
            </div>
          {% endif %}

          <div class="contact-form-group">
            <label for="contactName">Name</label>
            <input type="text" id="contactName" name="contact[name]" placeholder="Your name" required>
          </div>

          <div class="contact-form-group">
            <label for="contactEmail">Email</label>
            <input type="email" id="contactEmail" name="contact[email]" placeholder="your@email.com" required>
          </div>

          <div class="contact-form-group">
            <label for="contactSubject">Subject</label>
            <select id="contactSubject" name="contact[subject]">
              <option value="General Inquiry">General Inquiry</option>
              <option value="Product Question">Product Question</option>
              <option value="Order Support">Order Support</option>
              <option value="Wholesale Inquiry">Wholesale Inquiry</option>
              <option value="Other">Other</option>
            </select>
          </div>

          <div class="contact-form-group">
            <label for="contactMessage">Message</label>
            <textarea id="contactMessage" name="contact[body]" placeholder="How can we help?" rows="5" required></textarea>
          </div>

          <button type="submit" class="btn-primary contact-submit">
            Send Message
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><line x1="5" y1="12" x2="19" y2="12"/><polyline points="12 5 19 12 12 19"/></svg>
          </button>
        {% endform %}
      </div>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Contact Form",
  "settings": [
    {
      "type": "text",
      "id": "label",
      "label": "Section Label",
      "default": "Contact Us"
    },
    {
      "type": "html",
      "id": "title",
      "label": "Section Title",
      "default": "Get in <span class='highlight'>Touch</span>"
    },
    {
      "type": "textarea",
      "id": "subtitle",
      "label": "Subtitle",
      "default": "Have a question about NightForge or your order? We're here to help. Reach out and our team will get back to you as soon as possible."
    },
    {
      "type": "text",
      "id": "success_message",
      "label": "Success Message",
      "default": "Thanks for reaching out! We'll get back to you within 24-48 hours."
    }
  ],
  "blocks": [
    {
      "type": "detail",
      "name": "Contact Detail",
      "settings": [
        {
          "type": "select",
          "id": "icon",
          "label": "Icon",
          "options": [
            { "value": "email", "label": "Email" },
            { "value": "clock", "label": "Clock / Hours" },
            { "value": "map", "label": "Location" },
            { "value": "info", "label": "Info" }
          ],
          "default": "email"
        },
        {
          "type": "text",
          "id": "title",
          "label": "Title",
          "default": "Detail"
        },
        {
          "type": "text",
          "id": "text",
          "label": "Text",
          "default": "Detail text"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Contact Form",
      "blocks": [
        { "type": "detail", "settings": { "icon": "email", "title": "Email", "text": "support@resurrectnutrition.com" } },
        { "type": "detail", "settings": { "icon": "clock", "title": "Response Time", "text": "Within 24-48 hours" } },
        { "type": "detail", "settings": { "icon": "map", "title": "Location", "text": "Canada" } }
      ]
    }
  ]
}
{% endschema %}
