<section class="about-hero">
  <div class="container">
    <div class="about-hero-inner">
      <div class="section-label">{{ section.settings.label }}</div>
      <h1 class="section-title about-hero-title">{{ section.settings.title }}</h1>
      <p class="section-subtitle about-hero-subtitle">{{ section.settings.subtitle }}</p>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "About Hero",
  "settings": [
    {
      "type": "text",
      "id": "label",
      "label": "Section Label",
      "default": "Our Story"
    },
    {
      "type": "html",
      "id": "title",
      "label": "Page Title",
      "default": "Built on <span class='highlight'>Integrity</span>, Not Profit Margins"
    },
    {
      "type": "textarea",
      "id": "subtitle",
      "label": "Subtitle",
      "default": "Resurrect Nutrition exists because the supplement industry failed us. NightForge is the product we built when we stopped accepting mediocrity."
    }
  ],
  "presets": [
    {
      "name": "About Hero"
    }
  ]
}
{% endschema %}
