<section class="cart-page">
  <div class="container">
    <h1 class="cart-page-title">Your Cart</h1>

    {% if cart.item_count > 0 %}
      <div class="cart-page-inner">
        <div class="cart-page-items">
          {% for item in cart.items %}
            <div class="cart-page-item" data-line="{{ forloop.index }}">
              <div class="cart-page-item-image">
                {% if item.image %}
                  <img src="{{ item.image | image_url: width: 200 }}" alt="{{ item.title }}" loading="lazy">
                {% else %}
                  <img src="{{ 'hero.png' | asset_url }}" alt="{{ item.title }}" loading="lazy">
                {% endif %}
              </div>
              <div class="cart-page-item-details">
                <h3 class="cart-page-item-title">
                  <a href="{{ item.url }}">{{ item.product.title }}</a>
                </h3>
                {% if item.variant.title != 'Default Title' %}
                  <p class="cart-page-item-variant">{{ item.variant.title }}</p>
                {% endif %}
                <p class="cart-page-item-price">{{ item.price | money }}</p>
              </div>
              <div class="cart-page-item-qty">
                <button class="cart-qty-btn" onclick="changeCartQty({{ forloop.index }}, {{ item.quantity | minus: 1 }})" aria-label="Decrease quantity">
                  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><line x1="5" y1="12" x2="19" y2="12"/></svg>
                </button>
                <span class="cart-qty-value">{{ item.quantity }}</span>
                <button class="cart-qty-btn" onclick="changeCartQty({{ forloop.index }}, {{ item.quantity | plus: 1 }})" aria-label="Increase quantity">
                  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><line x1="12" y1="5" x2="12" y2="19"/><line x1="5" y1="12" x2="19" y2="12"/></svg>
                </button>
              </div>
              <div class="cart-page-item-total">
                {{ item.line_price | money }}
              </div>
              <button class="cart-page-item-remove" onclick="changeCartQty({{ forloop.index }}, 0)" aria-label="Remove item">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="18" y1="6" x2="6" y2="18"/><line x1="6" y1="6" x2="18" y2="18"/></svg>
              </button>
            </div>
          {% endfor %}
        </div>

        <div class="cart-page-summary">
          <div class="cart-page-shipping">
            <div class="cart-drawer-shipping-text">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"/></svg>
              <span id="cartPageShippingText">
                {% assign threshold_cents = settings.free_shipping_threshold | default: 50 | times: 100 %}
                {% if cart.total_price >= threshold_cents %}
                  You qualify for <strong>free shipping!</strong>
                {% else %}
                  {% assign remaining_cents = threshold_cents | minus: cart.total_price %}
                  Add <strong>{{ remaining_cents | money }}</strong> more for <strong>free shipping</strong>
                {% endif %}
              </span>
            </div>
            <div class="shipping-bar">
              {% assign ship_pct = cart.total_price | times: 100 | divided_by: threshold_cents %}
              {% if ship_pct > 100 %}{% assign ship_pct = 100 %}{% endif %}
              <div class="shipping-bar-fill" style="width:{{ ship_pct }}%"></div>
            </div>
          </div>

          <div class="cart-page-subtotal-row">
            <span>Subtotal</span>
            <span class="cart-page-subtotal">{{ cart.total_price | money }}</span>
          </div>
          <p class="cart-page-note">Shipping and taxes calculated at checkout.</p>

          <a href="/checkout" class="btn-primary cart-page-checkout">
            Checkout
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><line x1="5" y1="12" x2="19" y2="12"/><polyline points="12 5 19 12 12 19"/></svg>
          </a>
          <a href="/collections/all" class="cart-page-continue">Continue Shopping</a>
        </div>
      </div>
    {% else %}
      <div class="cart-page-empty">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><circle cx="9" cy="21" r="1"/><circle cx="20" cy="21" r="1"/><path d="M1 1h4l2.68 13.39a2 2 0 0 0 2 1.61h9.72a2 2 0 0 0 2-1.61L23 6H6"/></svg>
        <h2>Your cart is empty</h2>
        <p>Looks like you haven't added NightForge to your cart yet.</p>
        <a href="/collections/all" class="btn-primary">Shop NightForge</a>
      </div>
    {% endif %}
  </div>
</section>

{% schema %}
{
  "name": "Cart Content",
  "settings": []
}
{% endschema %}
