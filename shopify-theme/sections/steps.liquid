<section class="how-it-works" id="how">
  <div class="container">
    <div class="how-header">
      <div class="section-label">{{ section.settings.label }}</div>
      <h2 class="section-title">{{ section.settings.title }}</h2>
      <p class="section-subtitle">{{ section.settings.subtitle }}</p>
    </div>
    <div class="steps">
      {% for block in section.blocks %}
        <div class="step" {{ block.shopify_attributes }}>
          <div class="step-number"><span>{{ forloop.index }}</span></div>
          <h3 class="step-title">{{ block.settings.title }}</h3>
          <p class="step-desc">{{ block.settings.description }}</p>
        </div>
      {% endfor %}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "How It Works",
  "settings": [
    {
      "type": "text",
      "id": "label",
      "label": "Section Label",
      "default": "How It Works"
    },
    {
      "type": "html",
      "id": "title",
      "label": "Section Title",
      "default": "Simple. Effective. <span class='highlight'>Every Night.</span>"
    },
    {
      "type": "textarea",
      "id": "subtitle",
      "label": "Section Subtitle",
      "default": "No complicated routines. Just one capsule before bed and let your body do the rest."
    }
  ],
  "blocks": [
    {
      "type": "step",
      "name": "Step",
      "settings": [
        {
          "type": "text",
          "id": "title",
          "label": "Step Title",
          "default": "Step Title"
        },
        {
          "type": "textarea",
          "id": "description",
          "label": "Step Description",
          "default": "Step description goes here."
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "How It Works",
      "blocks": [
        { "type": "step", "settings": { "title": "Take Before Bed", "description": "Take NightForge 30 minutes before sleep. The tri-blend formula begins absorbing immediately." } },
        { "type": "step", "settings": { "title": "Recover While You Sleep", "description": "As you sleep, the magnesium works with your body's natural recovery processes to restore and rebuild." } },
        { "type": "step", "settings": { "title": "Wake Up Restored", "description": "Experience clearer thinking, better recovery, and reduced brain fog when you start your day." } }
      ]
    }
  ]
}
{% endschema %}