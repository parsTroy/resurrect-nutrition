<section class="product-section">
  <div class="container">
    <div class="product-inner">
      <!-- Product Image -->
      <div class="product-image-wrapper">
        {% if product.featured_image %}
          <img src="{{ product.featured_image | image_url: width: 960 }}" alt="{{ product.featured_image.alt | default: product.title }}" loading="eager">
        {% else %}
          <img src="{{ 'hero.png' | asset_url }}" alt="{{ product.title }}" loading="eager">
        {% endif %}
      </div>

      <!-- Product Details -->
      <div class="product-details">
        <div class="section-label">{{ section.settings.product_label }}</div>
        <h1 class="product-title">{{ product.title }}</h1>
        <div class="product-price" id="productPrice">{{ product.price | money }}</div>
        <div class="product-description">{{ product.description }}</div>

        <!-- Low Stock Indicator -->
        {% if section.settings.show_low_stock %}
          <div class="low-stock">
            <span class="low-stock-dot"></span>
            <span><strong>{{ section.settings.low_stock_label }}</strong> &mdash; {{ section.settings.low_stock_text }}</span>
          </div>
        {% endif %}

        <!-- Add to Cart Form -->
        {% form 'product', product %}
          {% if product.variants.size > 1 %}
            <!-- Multi-bottle / Variant Selector -->
            <div class="qty-discount-bar">
              <div class="qty-discount-options">
                {% for variant in product.variants %}
                  <div class="qty-option {% if variant == product.selected_or_first_available_variant %}selected{% endif %}" data-variant-id="{{ variant.id }}" data-variant-price="{{ variant.price }}" onclick="selectVariant(this)">
                    <div class="qty-option-count">{{ variant.title }}</div>
                    {% if variant.compare_at_price > variant.price %}
                      <div class="qty-option-save">Save {{ variant.compare_at_price | minus: variant.price | money }}</div>
                    {% endif %}
                  </div>
                {% endfor %}
              </div>
              <input type="hidden" name="id" id="variantInput" value="{{ product.selected_or_first_available_variant.id }}">
            </div>
          {% else %}
            <input type="hidden" name="id" value="{{ product.selected_or_first_available_variant.id }}">
          {% endif %}

          <div class="product-form-qty">
            <label for="qty">Quantity</label>
            <input type="number" id="qty" name="quantity" value="1" min="1" max="10">
          </div>

          <!-- Free Shipping Progress -->
          {% if section.settings.show_free_shipping %}
            <div class="shipping-progress" id="shippingProgress">
              <div class="shipping-progress-text">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"/></svg>
                <span id="shippingText">You qualify for <strong>free shipping</strong></span>
              </div>
              <div class="shipping-bar">
                <div class="shipping-bar-fill" id="shippingFill" style="width:100%"></div>
              </div>
            </div>
          {% endif %}

          <button type="submit" class="btn-primary product-add-to-cart" {% unless product.available %}disabled{% endunless %}>
            {% if product.available %}
              {{ 'products.product.add_to_cart' | t }}
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><line x1="5" y1="12" x2="19" y2="12"/><polyline points="12 5 19 12 12 19"/></svg>
            {% else %}
              {{ 'products.product.sold_out' | t }}
            {% endif %}
          </button>
        {% endform %}

        <!-- Social Proof / Recent Activity -->
        {% if section.settings.show_social_proof %}
          <div class="recent-activity" id="recentActivity">
            <span class="recent-activity-dot"></span>
            <span id="activityText">{{ section.settings.social_proof_1 }}</span>
          </div>
        {% endif %}

        <!-- Trust Badges -->
        <div class="product-trust">
          <span class="product-trust-item">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="11" width="18" height="11" rx="2" ry="2"/><path d="M7 11V7a5 5 0 0 1 10 0v4"/></svg>
            Secure Checkout
          </span>
          <span class="product-trust-item">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/></svg>
            Privacy Protected
          </span>
          <span class="product-trust-item">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="1" y="3" width="15" height="13"/><polygon points="16 8 20 8 23 11 23 16 16 16 16 8"/><circle cx="5.5" cy="18.5" r="2.5"/><circle cx="18.5" cy="18.5" r="2.5"/></svg>
            Fast Shipping
          </span>
          <span class="product-trust-item">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"/></svg>
            Quality Guaranteed
          </span>
        </div>

        <!-- Guarantee -->
        <div class="product-guarantee">
          <div class="product-guarantee-icon">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/></svg>
          </div>
          <div>
            <div class="product-guarantee-title">{{ section.settings.guarantee_title }}</div>
            <div class="product-guarantee-desc">{{ section.settings.guarantee_text }}</div>
          </div>
        </div>

        <!-- Feature Reminders -->
        <div class="product-features">
          {% for block in section.blocks %}
            <div class="product-feature-item" {{ block.shopify_attributes }}>
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"/></svg>
              {{ block.settings.text }}
            </div>
          {% endfor %}
        </div>
      </div>
    </div>
  </div>
</section>

<!-- Social proof messages data for JS rotation -->
{% if section.settings.show_social_proof %}
<script>
  var socialProofMessages = [
    {{ section.settings.social_proof_1 | json }},
    {{ section.settings.social_proof_2 | json }},
    {{ section.settings.social_proof_3 | json }},
    {{ section.settings.social_proof_4 | json }},
    {{ section.settings.social_proof_5 | json }}
  ].filter(function(m) { return m && m.length > 0; });

  var freeShippingThreshold = {{ section.settings.free_shipping_threshold | default: 50 }};
</script>
{% endif %}

{% schema %}
{
  "name": "Product Info",
  "settings": [
    {
      "type": "text",
      "id": "product_label",
      "label": "Product Label",
      "default": "Resurrect Nutrition"
    },
    {
      "type": "header",
      "content": "Low Stock Indicator"
    },
    {
      "type": "checkbox",
      "id": "show_low_stock",
      "label": "Show low stock notice",
      "default": true
    },
    {
      "type": "text",
      "id": "low_stock_label",
      "label": "Low Stock Label",
      "default": "Limited stock"
    },
    {
      "type": "text",
      "id": "low_stock_text",
