      "label": "Show social proof messages",
      "default": true
    },
    {
      "type": "text",
      "id": "social_proof_1",
      "label": "Message 1",
      "default": "12 people ordered NightForge today"
    },
    {
      "type": "text",
      "id": "social_proof_2",
      "label": "Message 2",
      "default": "A customer in Texas just ordered 2 bottles"
    },
    {
      "type": "text",
      "id": "social_proof_3",
      "label": "Message 3",
      "default": "23 people are viewing NightForge right now"
    },
    {
      "type": "text",
      "id": "social_proof_4",
      "label": "Message 4",
      "default": "A customer in California just placed an order"
    },
    {
      "type": "text",
      "id": "social_proof_5",
      "label": "Message 5",
      "default": "NightForge is trending this week"
    },
    {
      "type": "header",
      "content": "Guarantee"
    },
    {
      "type": "text",
      "id": "guarantee_title",
      "label": "Guarantee Title",
      "default": "Satisfaction Guarantee"
    },
    {
      "type": "textarea",
      "id": "guarantee_text",
      "label": "Guarantee Text",
      "default": "We stand behind NightForge. If you're not satisfied with your results, contact us and we'll make it right. Premium quality, zero risk."
    }
  ],
  "blocks": [
    {
      "type": "feature",
      "name": "Feature Reminder",
      "settings": [
        {
          "type": "text",
          "id": "text",
          "label": "Feature Text",
          "default": "Feature text"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Product Info",
      "blocks": [
        { "type": "feature", "settings": { "text": "Premium Magnesium Tri-Blend — 3 bioavailable forms" } },
        { "type": "feature", "settings": { "text": "Zero fillers, zero buffers, zero cheap ingredients" } },
        { "type": "feature", "settings": { "text": "Formulated for nighttime recovery and deep sleep" } },
        { "type": "feature", "settings": { "text": "No magnesium oxide or citrate — only premium forms" } }
      ]
