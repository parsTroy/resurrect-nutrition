<footer class="footer">
  <div class="container">
    <div class="footer-inner">
      <div class="footer-brand">{{ section.settings.brand_text }}</div>
      <ul class="footer-links">
        {% for link in linklists[section.settings.menu].links %}
          <li><a href="{{ link.url }}">{{ link.title }}</a></li>
        {% endfor %}
      </ul>
      <p class="footer-copy">&copy; {{ 'now' | date: '%Y' }} {{ section.settings.copyright_text }}</p>
    </div>
  </div>
</footer>

{% schema %}
{
  "name": "Footer",
  "settings": [
    {
      "type": "text",
      "id": "brand_text",
      "label": "Brand Text",
      "default": "Resurrect Nutrition Inc"
    },
    {
      "type": "link_list",
      "id": "menu",
      "label": "Footer Menu",
      "default": "footer"
    },
    {
      "type": "text",
      "id": "copyright_text",
      "label": "Copyright Text",
      "default": "Resurrect Nutrition Inc. All rights reserved."
    }
  ]
}
{% endschema %}