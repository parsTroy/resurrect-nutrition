<section class="ingredients" id="ingredients">
  <div class="container">
    <div class="ingredients-inner">
      <div class="ingredients-content">
        <div class="section-label">{{ section.settings.label }}</div>
        <h2 class="section-title">{{ section.settings.title }}</h2>
        <p class="section-subtitle">{{ section.settings.subtitle }}</p>
        <div class="ingredient-list">
          {% for block in section.blocks %}
            {% if block.type == 'benefit' %}
              <div class="ingredient-item" {{ block.shopify_attributes }}>
                <div class="ingredient-marker"></div>
                <div>
                  <h4>{{ block.settings.title }}</h4>
                  <p>{{ block.settings.description }}</p>
                </div>
              </div>
            {% endif %}
          {% endfor %}
        </div>
      </div>
      <div class="ingredients-visual">
        <div class="tri-blend-label">{{ section.settings.tri_blend_label }}</div>
        <div class="tri-blend-dosage">{{ section.settings.dosage_text }}</div>
        <div class="tri-blend-forms">
          {% for block in section.blocks %}
            {% if block.type == 'form' %}
              <div class="tri-blend-form" {{ block.shopify_attributes }}>
                <h4>{{ block.settings.title }}</h4>
                <p>{{ block.settings.description }}</p>
              </div>
            {% endif %}
          {% endfor %}
        </div>
        <div class="tri-blend-clean">{{ section.settings.clean_label }}</div>
      </div>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Ingredients",
  "settings": [
    {
      "type": "text",
      "id": "label",
      "label": "Section Label",
      "default": "Ingredients"
    },
    {
      "type": "html",
      "id": "title",
      "label": "Section Title",
      "default": "Why the <span class='highlight'>Tri-Blend</span> Matters"
    },
    {
      "type": "textarea",
      "id": "subtitle",
      "label": "Section Subtitle",
      "default": "A single form of magnesium has limitations. By combining three premium, bioavailable forms, NightForge delivers complete coverage that cheap supplements simply cannot match."
    },
    {
      "type": "text",
      "id": "tri_blend_label",
      "label": "Tri-Blend Card Label",
      "default": "The Tri-Blend — 375mg Per Serving"
    },
    {
      "type": "text",
      "id": "dosage_text",
      "label": "Dosage Text",
      "default": "3 capsules per day · 125mg elemental Mg per capsule"
    },
    {
      "type": "text",
      "id": "clean_label",
      "label": "Clean Label Text",
      "default": "100% clean — no oxide, no citrate, no rice flour, no fillers"
    }
  ],
  "blocks": [
    {
      "type": "benefit",
      "name": "Ingredient Benefit",
      "settings": [
        {
          "type": "text",
          "id": "title",
          "label": "Title",
          "default": "Benefit Title"
        },
        {
          "type": "textarea",
          "id": "description",
          "label": "Description",
          "default": "Benefit description."
        }
      ]
    },
    {
      "type": "form",
      "name": "Tri-Blend Form",
      "settings": [
        {
          "type": "text",
          "id": "title",
          "label": "Form Title",
          "default": "Form — Function"
        },
        {
          "type": "textarea",
          "id": "description",
          "label": "Form Description",
          "default": "Form description."
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Ingredients",
      "blocks": [
        { "type": "benefit", "settings": { "title": "Superior Bioavailability", "description": "Each form is selected for high absorption rates, ensuring your body actually uses what you take." } },
        { "type": "benefit", "settings": { "title": "No Cheap Forms", "description": "We exclude magnesium oxide and citrate entirely. These are the lowest-quality forms used to cut costs." } },
        { "type": "benefit", "settings": { "title": "Multi-Pathway Absorption", "description": "Three forms means three pathways for absorption. Your body gets more magnesium from every dose." } },
        { "type": "benefit", "settings": { "title": "Clean Formula", "description": "Zero fillers, zero buffers. Non-medicinal ingredient: Hypromellose (vegetable capsule). That's it." } },
        { "type": "form", "settings": { "title": "Magnesium L-Threonate — Brain & Cognition", "description": "The only form clinically shown to cross the blood-brain barrier. Targets cognitive function, reduces brain fog, and supports mental clarity." } },
        { "type": "form", "settings": { "title": "Magnesium Bisglycinate (Non-Buffered) — Muscle & Recovery", "description": "Highly bioavailable chelated form. Supports muscle relaxation, reduces tension, and promotes physical recovery without GI distress." } },
        { "type": "form", "settings": { "title": "Magnesium Taurate — Sleep & Nervous System", "description": "Combines magnesium with taurine for cardiovascular and nervous system support. Promotes deep sleep quality and heart muscle function." } }
      ]
    }
  ]
}
{% endschema %}
